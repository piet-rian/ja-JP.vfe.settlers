  <VFES_Gun_DoubleActionRevolver.verbs.Verb_Shoot.label>発射</VFES_Gun_DoubleActionRevolver.verbs.Verb_Shoot.label>

  <!-- EN: double-barreled shotgun -->
  <VFES_Gun_DoubleBarreledShotgun.label>二連式ショットガン</VFES_Gun_DoubleBarreledShotgun.label>
  <!-- EN: An ancient design of shotgun with two individually loaded barrels, that emits a
  tight-packed spray of pellets. -->
  <VFES_Gun_DoubleBarreledShotgun.description>個別に装填する二つの銃身を持つ古典的なショットガン。密集した散弾を放ちます。</VFES_Gun_DoubleBarreledShotgun.description>
